          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_namespace=~\"$ns\", service_name=~\"$service\"}[5m]))))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
