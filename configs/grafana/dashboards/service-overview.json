          },
          "expr": "topk(10, sum by (http_route) (rate(http_server_request_duration_seconds_count{service_namespace=~\"$ns\", service_name=~\"$service\"}[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
