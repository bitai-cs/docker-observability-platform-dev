    {
      "id": 10,
      "type": "timeseries",
      "title": "Tempo / Loki / Prometheus: ingested samples or spans",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))",
          "legendFormat": "Tempo spans/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
          "legendFormat": "Loki lines/s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
