          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Collector memory (RSS) and CPU",
      "description": "",
      "gridPos": {
        "x": 12,
