# Copy to .env and adjust. .env is never committed.
# Non-sensitive values only in this example file.

# Address of this Docker server on the LAN. Published ports bind to it.
BIND_ADDRESS=10.0.0.201

# Published ports (host side)
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_HEALTH_PORT=13133
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MAILPIT_UI_PORT=8025

# Grafana administrator (replace the password; individual developer accounts
# are created by this administrator in the Grafana UI)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Pinned image tags (spec section 15.3)
OTELCOL_TAG=0.164.0
TEMPO_TAG=3.1.1
LOKI_TAG=3.7.9
GRAFANA_TAG=13.2.4
PROMETHEUS_TAG=v3.15.1
ALERTMANAGER_TAG=v0.34.1
MAILPIT_TAG=v1.32.0
TELEMETRYGEN_TAG=v0.164.1
